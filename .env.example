# ==============================================================================
# HỆ THỐNG SỔ GỐC BKD TTNG (FINANCE-VPM) - CẤU HÌNH MẪU (.env.example)
# ==============================================================================

# 1. Server Configuration
PORT=3001
NODE_ENV=production

# 2. PostgreSQL Database Configuration (Local hoặc Vercel Postgres / Neon)
# Khi gắn Vercel Postgres trên Vercel Dashboard -> Storage, biến POSTGRES_URL và DATABASE_URL sẽ tự động được gắn.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_SCHEMA=finance_vpm
DB_SSL=true

# 3. Google Apps Script Webhook REST API (Database Controller)
GOOGLE_SHEET_API_URL=https://script.google.com/macros/s/AKfycbyFWBCmwLG3cEKSGMxWSKs4wI5vuGKB3BfBh992u9GgwYHSXzxSq27QA7_lpl5AJjNYGQ/exec

# 4. Bootstrap Master Account (Tự động khởi tạo tài khoản Master khi tạo bảng trên Vercel Postgres)
AUTH_BOOTSTRAP_USERNAME=master
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
AUTH_BOOTSTRAP_DISPLAY_NAME=Sếp Mavryk
